# Copy to `.env` for local development:  cp .env.example .env
# `.env` is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# On-box model (the `local-llm` compose profile)
# ---------------------------------------------------------------------------
# Compose reconciles away any service outside the ACTIVE profile set, so a plain
# `docker compose up -d <service>` would stop the local model unless the profile
# stays selected. Setting it here keeps it active for every compose command.
COMPOSE_PROFILES=local-llm

# Required by the bundled NVIDIA NIM image (https://ngc.nvidia.com).
NGC_API_KEY=

# Point the proxy at a different OpenAI-compatible server instead of the NIM
# profile (vLLM, llama.cpp, Ollama, …). Leave unset to use the profile.
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:14b

# ---------------------------------------------------------------------------
# Cloud LLM backends (all optional — set whichever you use)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Model the chat plans with by default. Prefix `local/` to pin the on-box model.
# CHAT_MODEL=local/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Compose wires the llm-proxy token and the agent's caller key to the
# per-deployment operator key automatically (mcpfinder_keys volume); nothing
# to set here. To call the proxy or agent directly:
#   curl -H "Authorization: Bearer $(docker compose exec -T core-agent cat /keys/runtime-api-key)" ...
